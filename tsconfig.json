{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["backend/*"],
      "@ai/*": ["ai/*"],
      "@database/*": ["database/*"]
    }
  },
  "include": ["backend/**/*", "ai/**/*", "database/**/*", "tests/**/*"]
}


# ==============================================================================
# Sethu Hub — Environment Configuration
# "Where Sethu Connects."
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=./database/sethu_hub.sqlite

# Security & Authentication
JWT_SECRET=sethu_hub_jwt_secret_sit_2026_production_grade_token_key
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Institutional Rules
# Set to 'true' to restrict registration to @sethu.ac.in emails
ENABLE_INSTITUTIONAL_EMAIL_RESTRICTION=false

# AI Configuration
# Options: 'local' (deterministic built-in semantic & NLP engine) or 'gemini'
AI_PROVIDER=local
GEMINI_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info

